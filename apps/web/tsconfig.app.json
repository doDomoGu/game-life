{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "paths": {
      "@game-life/platform-web": ["../../packages/platform-web/src/index.ts"],
      "@game-life/platform-web/*": ["../../packages/platform-web/src/*"],
      "@game-life/game-poker-memory/*": ["../../games/poker-memory/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
